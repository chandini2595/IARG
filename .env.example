# Environment Configuration for IARG

# Application
NODE_ENV=development
LOG_LEVEL=debug

# Database Configuration
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=password123

REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=redis123

# Message Broker
KAFKA_BROKERS=localhost:9092
AZURE_EVENT_HUB_CONNECTION_STRING=

# Storage
IPFS_API_URL=http://localhost:5001
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123

# Azure Configuration
AZURE_SUBSCRIPTION_ID=
AZURE_RESOURCE_GROUP=iarg-rg
AZURE_KEY_VAULT_URL=
AZURE_STORAGE_ACCOUNT=
AZURE_STORAGE_KEY=

# External APIs
GITHUB_TOKEN=
GITHUB_REPOS=facebook/react,tensorflow/tensorflow
GITHUB_WEBHOOK_SECRET=
HUGGINGFACE_TOKEN=
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USERNAME=
SNOWFLAKE_PASSWORD=
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
# Drive API ACL monitor (optional). Run: cd app/guardian && python scripts/google_drive_oauth_refresh_token.py
GOOGLE_DRIVE_REFRESH_TOKEN=
GOOGLE_DRIVE_MONITOR_ENABLED=false
GOOGLE_DRIVE_MONITORED_IDS=
GOOGLE_DRIVE_POLL_INTERVAL_SECONDS=300
GOOGLE_DRIVE_FOLDER_MAX_CHILDREN=50
# Comma-separated; if set, new user shares to emails outside these domains trigger
GOOGLE_DRIVE_ALLOWED_EMAIL_DOMAINS=
# If true, new "domain" type permissions trigger (noisy in many orgs)
GOOGLE_DRIVE_FLAG_DOMAIN_SHARES=false
# Optional: require X-IARG-Drive-Breach-Secret on POST /api/guardian/google-drive/breach
DRIVE_BREACH_WEBHOOK_SECRET=
DRIVE_BREACH_SYNTHETIC_RISK_SCORE=95.0

# Insurance APIs
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
LLOYDS_SANDBOX_API_KEY=

# IARG Guardian (MVP)
RISK_THRESHOLD=70.0
COOLDOWN_HOURS=24
SCAN_WINDOW_DAYS=14
ENABLE_STABILITY_PENALTY=false
STALE_DAYS_THRESHOLD=180
DB_PATH=/app/data/guardian.sqlite

# Risk model (demo)
# Use "heuristic" for the current rule-based scoring.
# Use "xgb-demo" to train an XGBoost model on synthetic data that matches the heuristic.
RISK_MODEL_TYPE=heuristic
XGB_MODEL_PATH=/app/model/xgb_risk_model.json
XGB_DEMO_SAMPLES=2000

# AI/ML Configuration
OPENAI_API_KEY=
HUGGINGFACE_API_KEY=
MODEL_SERVING_URL=http://localhost:8501

# Security
JWT_SECRET=your-jwt-secret-key-here
HMAC_SECRET=your-hmac-secret-key-here
ENCRYPTION_KEY=your-32-char-encryption-key-here

# Monitoring
GRAFANA_URL=http://localhost:3000
PROMETHEUS_URL=http://localhost:9090

# Feature Flags
ENABLE_AI_SCORING=true
ENABLE_INSURANCE_AUTOMATION=true
ENABLE_EVIDENCE_PACKAGING=true