{
  "name": "@iarg/dashboard",
  "version": "1.0.0",
  "description": "IARG Dashboard - React frontend for asset visualization and management",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest",
